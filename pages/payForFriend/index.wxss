/**pages/payForFriend/index.wxss**/\n\npage {\n  background-color: #f5f5f5;\n}\n\n.container {\n  min-height: 100vh;\n  display: flex;\n  flex-direction: column;\n}\n\n/* 加载状态 */\n.loading-container {\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: 20rpx;\n}\n\n.spinner {\n  width: 50rpx;\n  height: 50rpx;\n  border: 4rpx solid #f3f3f3;\n  border-top: 4rpx solid #ff5722;\n  border-radius: 50%;\n  animation: spin 0.8s linear infinite;\n}\n\n@keyframes spin {\n  0% { transform: rotate(0deg); }\n  100% { transform: rotate(360deg); }\n}\n\n.loading-text {\n  color: #666;\n  font-size: 26rpx;\n}\n\n/* 错误状态 */\n.error-container {\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: 16rpx;\n  padding: 40rpx 40rpx;\n}\n\n.error-icon {\n  font-size: 80rpx;\n  line-height: 1;\n}\n\n.error-title {\n  font-size: 32rpx;\n  font-weight: 600;\n  color: #333;\n  text-align: center;\n}\n\n.error-desc {\n  font-size: 24rpx;\n  color: #999;\n  text-align: center;\n  line-height: 1.6;\n}\n\n.btn-retry {\n  margin-top: 30rpx;\n  width: 200rpx;\n  height: 48rpx;\n  background: #ff5722;\n  color: #fff;\n  border-radius: 24rpx;\n  font-size: 26rpx;\n}\n\n.btn-retry::after {\n  border: none;\n}\n\n/* 内容区域 */\n.content {\n  flex: 1;\n  padding: 20rpx 0 120rpx 0;\n  display: flex;\n  flex-direction: column;\n}\n\n/* 倒计时横幅 */\n.countdown-banner {\n  background: linear-gradient(135deg, #fff9f5 0%, #ffe8e0 100%);\n  border-left: 4rpx solid #ff5722;\n  padding: 16rpx 24rpx;\n  margin: 0 20rpx 20rpx 20rpx;\n  border-radius: 8rpx;\n  display: flex;\n  align-items: center;\n  gap: 12rpx;\n}\n\n.countdown-text {\n  color: #666;\n  font-size: 24rpx;\n}\n\n.countdown-time {\n  color: #ff5722;\n  font-size: 28rpx;\n  font-weight: 600;\n  font-family: 'Courier New', monospace;\n}\n\n/* 过期横幅 */\n.expire-banner {\n  background-color: #ffe8e0;\n  color: #d32f2f;\n  padding: 16rpx 24rpx;\n  margin: 0 20rpx 20rpx 20rpx;\n  border-radius: 8rpx;\n  text-align: center;\n  font-size: 24rpx;\n  font-weight: 500;\n}\n\n/* 卡片基础样式 */\n.card-item {\n  background-color: #fff;\n  border-radius: 16rpx;\n  margin: 0 20rpx 16rpx 20rpx;\n  padding: 24rpx;\n  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);\n}\n\n/* 用户卡片 */\n.user-card {\n  padding: 24rpx;\n}\n\n.user-header {\n  display: flex;\n  align-items: center;\n  gap: 16rpx;\n  margin-bottom: 16rpx;\n}\n\n.user-avatar {\n  width: 56rpx;\n  height: 56rpx;\n  border-radius: 50%;\n  background-color: #f5f5f5;\n  flex-shrink: 0;\n}\n\n.user-info {\n  flex: 1;\n}\n\n.user-name {\n  font-size: 28rpx;\n  font-weight: 600;\n  color: #333;\n  margin-bottom: 4rpx;\n}\n\n.user-request {\n  font-size: 24rpx;\n  color: #999;\n}\n\n/* 留言框 */\n.message-box {\n  background-color: #fafafa;\n  border-radius: 8rpx;\n  padding: 16rpx;\n  margin-top: 12rpx;\n  border-left: 3rpx solid #ff5722;\n}\n\n.message-content {\n  font-size: 24rpx;\n  color: #333;\n  line-height: 1.6;\n}\n\n/* 详情卡片 */\n.detail-card {\n  padding: 20rpx 24rpx;\n}\n\n.detail-item {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 12rpx 0;\n  font-size: 26rpx;\n}\n\n.detail-label {\n  color: #666;\n}\n\n.detail-value {\n  color: #333;\n  font-weight: 600;\n}\n\n.detail-value.amount {\n  color: #ff5722;\n  font-size: 32rpx;\n}\n\n.detail-value.order-id {\n  font-size: 20rpx;\n  color: #999;\n  font-family: 'Courier New', monospace;\n  word-break: break-all;\n}\n\n.divider {\n  height: 1rpx;\n  background-color: #eee;\n  margin: 8rpx 0;\n}\n\n/* 提示卡片 */\n.tips-card {\n  background-color: #f0f9ff;\n  border-left: 4rpx solid #2196f3;\n}\n\n.tips-title {\n  font-size: 26rpx;\n  font-weight: 600;\n  color: #333;\n  margin-bottom: 16rpx;\n}\n\n.tips-item {\n  display: flex;\n  align-items: flex-start;\n  gap: 12rpx;\n  margin-bottom: 10rpx;\n  font-size: 24rpx;\n}\n\n.tips-item:last-child {\n  margin-bottom: 0;\n}\n\n.tips-icon {\n  color: #2196f3;\n  font-size: 20rpx;\n  flex-shrink: 0;\n  margin-top: 2rpx;\n}\n\n.tips-text {\n  color: #666;\n  flex: 1;\n  line-height: 1.5;\n}\n\n/* 按钮容器 */\n.button-container {\n  padding: 20rpx 20rpx;\n  position: fixed;\n  bottom: 0;\n  left: 0;\n  right: 0;\n  background: linear-gradient(to bottom, transparent, rgba(255, 255, 255, 0.95) 20%, #fff);\n  z-index: 10;\n}\n\n/* 支付按钮 */\n.btn-pay {\n  width: 100%;\n  height: 60rpx;\n  background: linear-gradient(135deg, #ff7043 0%, #ff5722 100%);\n  color: #fff;\n  border: none;\n  border-radius: 30rpx;\n  font-size: 32rpx;\n  font-weight: 600;\n  box-shadow: 0 4rpx 16rpx rgba(255, 87, 34, 0.35);\n}\n\n.btn-pay::after {\n  border: none;\n}\n\n.btn-pay:active:not([disabled]) {\n  opacity: 0.9;\n  transform: scale(0.98);\n}\n\n.btn-pay[disabled] {\n  opacity: 0.7;\n}\n\n.btn-text {\n  display: block;\n  font-weight: 600;\n}\n\n.button-hint {\n  text-align: center;\n  color: #999;\n  font-size: 22rpx;\n  margin-top: 10rpx;\n}\n\n/* 成功状态 */\n.status-success {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 12rpx;\n  padding: 30rpx 20rpx;\n}\n\n.status-icon {\n  font-size: 60rpx;\n  color: #4caf50;\n}\n\n.status-text {\n  font-size: 28rpx;\n  color: #333;\n  font-weight: 600;\n}\n\n/* 大屏幕适配 */\n@media (min-width: 414px) {\n  .card-item {\n    margin-left: 30rpx;\n    margin-right: 30rpx;\n  }\n\n  .countdown-banner {\n    margin-left: 30rpx;\n    margin-right: 30rpx;\n  }\n\n  .button-container {\n    padding: 20rpx 30rpx;\n  }\n}