<!--pages/payForFriend/index.wxml-->\n<view class=\"container\">\n  <!-- 加载状态 -->\n  <view wx:if=\"{{loading}}\" class=\"loading-container\">\n    <view class=\"spinner\"></view>\n    <text class=\"loading-text\">加载中...</text>\n  </view>\n\n  <!-- 错误状态 -->\n  <view wx:if=\"{{error}}\" class=\"error-container\">\n    <view class=\"error-icon\">⚠️</view>\n    <text class=\"error-title\">{{error}}</text>\n    <text class=\"error-desc\">{{errorDesc}}</text>\n    <button class=\"btn-retry\" bindtap=\"onRetry\">重新加载</button>\n  </view>\n\n  <!-- 正常内容 -->\n  <view wx:if=\"{{!loading && !error}}\" class=\"content\">\n    <!-- 倒计时提示 -->\n    <view class=\"countdown-banner\" wx:if=\"{{countdownSeconds > 0}}\">\n      <text class=\"countdown-text\">订单有效期：</text>\n      <text class=\"countdown-time\">{{formattedCountdown}}</text>\n    </view>\n\n    <!-- 过期提示 -->\n    <view class=\"expire-banner\" wx:if=\"{{countdownSeconds <= 0}}\">\n      <text>⏰ 订单已过期，请联系发起人重新发起</text>\n    </view>\n\n    <!-- 发起人信息卡片 -->\n    <view class=\"card-item user-card\">\n      <view class=\"user-header\">\n        <image class=\"user-avatar\" src=\"{{payDetail.initiatorAvatar}}\" mode=\"aspectFill\"></image>\n        <view class=\"user-info\">\n          <view class=\"user-name\">{{payDetail.initiatorName}}</view>\n          <view class=\"user-request\">请你帮我付款</view>\n        </view>\n      </view>\n      \n      <!-- 用户留言 -->\n      <view class=\"message-box\" wx:if=\"{{payDetail.message}}\">\n        <text class=\"message-content\">💬 {{payDetail.message}}</text>\n      </view>\n    </view>\n\n    <!-- 订单详情卡片 -->\n    <view class=\"card-item detail-card\">\n      <view class=\"detail-item\">\n        <text class=\"detail-label\">商品</text>\n        <text class=\"detail-value\">{{payDetail.productName}}</text>\n      </view>\n      <view class=\"divider\"></view>\n      <view class=\"detail-item\">\n        <text class=\"detail-label\">金额</text>\n        <text class=\"detail-value amount\">¥{{payDetail.amount}}</text>\n      </view>\n      <view class=\"divider\"></view>\n      <view class=\"detail-item\">\n        <text class=\"detail-label\">订单号</text>\n        <text class=\"detail-value order-id\">{{payDetail.orderId}}</text>\n      </view>\n    </view>\n\n    <!-- 提示卡片 -->\n    <view class=\"card-item tips-card\">\n      <view class=\"tips-title\">📋 支付提示</view>\n      <view class=\"tips-item\">\n        <text class=\"tips-icon\">✓</text>\n        <text class=\"tips-text\">支付后款项将直接转给发起人</text>\n      </view>\n      <view class=\"tips-item\">\n        <text class=\"tips-icon\">✓</text>\n        <text class=\"tips-text\">支付过程中请勿关闭此页面</text>\n      </view>\n      <view class=\"tips-item\">\n        <text class=\"tips-icon\">✓</text>\n        <text class=\"tips-text\">支付完成后系统将自动跳转</text>\n      </view>\n    </view>\n\n    <!-- 底部支付按钮 -->\n    <view class=\"button-container\" wx:if=\"{{countdownSeconds > 0 && orderStatus === 0}}\">\n      <button\n        class=\"btn-pay\"\n        bindtap=\"onPaymentClick\"\n        loading=\"{{paying}}\"\n        disabled=\"{{paying}}\"\n      >\n        <text class=\"btn-text\">替 TA 付款 ¥{{payDetail.amount}}</text>\n      </button>\n      <view class=\"button-hint\">使用微信钱包支付</view>\n    </view>\n\n    <!-- 状态提示 -->\n    <view class=\"button-container\" wx:if=\"{{orderStatus === 2}}\">\n      <view class=\"status-success\">\n        <text class=\"status-icon\">✓</text>\n        <text class=\"status-text\">订单已完成支付</text>\n      </view>\n    </view>\n  </view>\n</view>