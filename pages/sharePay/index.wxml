<!--pages/sharePay/index.wxml-->\n<view class=\"container\">\n  <!-- 头部卡片 -->\n  <view class=\"card-header\">\n    <view class=\"section-title\">订单摘要</view>\n  </view>\n\n  <!-- 商品信息卡片 -->\n  <view class=\"card-item\">\n    <view class=\"product-info\">\n      <image class=\"product-image\" src=\"data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 200 200'%3E%3Crect width='200' height='200' fill='%23ff7043'/%3E%3Ctext x='100' y='110' font-size='40' fill='%23fff' text-anchor='middle' dominant-baseline='middle'%3E奶茶%3C/text%3E%3C/svg%3E\" mode=\"aspectFill\"></image>\n      <view class=\"product-details\">\n        <view class=\"product-name\">奶��饮品</view>\n        <view class=\"product-desc\">2x 珍珠奶茶 + 1x 芋头奶茶</view>\n        <view class=\"product-price\">¥<text class=\"price-text\">{{amount}}</text></view>\n      </view>\n    </view>\n  </view>\n\n  <!-- 留言编辑区 -->\n  <view class=\"card-item message-card\">\n    <view class=\"message-label\">给好友的留言（可选）</view>\n    <textarea\n      class=\"message-input\"\n      placeholder=\"比如：帮我付一下，请你喝奶茶！\"\n      placeholder-class=\"input-placeholder\"\n      maxlength=\"100\"\n      bindinput=\"onMessageInput\"\n      value=\"{{message}}\"\n    ></textarea>\n    <view class=\"message-count\">{{message.length}}/100</view>\n  </view>\n\n  <!-- 代付说明 -->\n  <view class=\"card-item tips-card\">\n    <view class=\"tips-title\">代付说明</view>\n    <view class=\"tips-item\">\n      <text class=\"tips-icon\">●</text>\n      <text class=\"tips-text\">好友有10分钟时间完成支付</text>\n    </view>\n    <view class=\"tips-item\">\n      <text class=\"tips-icon\">●</text>\n      <text class=\"tips-text\">如好友未及时支付，订单将自动关闭</text>\n    </view>\n    <view class=\"tips-item\">\n      <text class=\"tips-icon\">●</text>\n      <text class=\"tips-text\">支付完成后，款项将直接转账</text>\n    </view>\n  </view>\n\n  <!-- 发送按钮 -->\n  <view class=\"button-container\">\n    <button\n      class=\"btn-share\"\n      open-type=\"share\"\n      bindtap=\"handleShare\"\n    >\n      <text class=\"btn-icon\">📱</text>\n      <text>发送给微信好友</text>\n    </button>\n    <view class=\"button-hint\">点击上方按钮分享给好友，让TA帮你付款</view>\n  </view>\n</view>