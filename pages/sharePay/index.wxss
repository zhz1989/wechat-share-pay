/**pages/sharePay/index.wxss**/\n\npage {\n  background-color: #f5f5f5;\n}\n\n.container {\n  padding: 20rpx 0 40rpx 0;\n  min-height: 100vh;\n}\n\n/* 头部标题 */\n.card-header {\n  padding: 30rpx 30rpx 20rpx 30rpx;\n  background: linear-gradient(135deg, #ff7043 0%, #ff5722 100%);\n  color: #fff;\n}\n\n.section-title {\n  font-size: 32rpx;\n  font-weight: 600;\n  color: #fff;\n}\n\n/* 卡片基础样式 */\n.card-item {\n  background-color: #fff;\n  border-radius: 16rpx;\n  margin: 20rpx 20rpx 0 20rpx;\n  padding: 24rpx;\n  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);\n}\n\n/* 商品信息卡片 */\n.product-info {\n  display: flex;\n  gap: 20rpx;\n}\n\n.product-image {\n  width: 120rpx;\n  height: 120rpx;\n  border-radius: 12rpx;\n  flex-shrink: 0;\n  background-color: #f5f5f5;\n}\n\n.product-details {\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n  justify-content: space-between;\n  padding: 4rpx 0;\n}\n\n.product-name {\n  font-size: 30rpx;\n  font-weight: 600;\n  color: #333;\n  margin-bottom: 8rpx;\n}\n\n.product-desc {\n  font-size: 24rpx;\n  color: #999;\n  margin-bottom: 12rpx;\n  line-height: 1.4;\n}\n\n.product-price {\n  font-size: 28rpx;\n  color: #ff5722;\n  font-weight: 600;\n}\n\n.price-text {\n  font-size: 40rpx;\n  font-weight: 700;\n}\n\n/* 消息卡片 */\n.message-card {\n  position: relative;\n}\n\n.message-label {\n  font-size: 28rpx;\n  font-weight: 600;\n  color: #333;\n  margin-bottom: 16rpx;\n}\n\n.message-input {\n  width: 100%;\n  min-height: 120rpx;\n  padding: 12rpx 16rpx;\n  border: 1rpx solid #eee;\n  border-radius: 8rpx;\n  font-size: 26rpx;\n  box-sizing: border-box;\n  font-family: inherit;\n  line-height: 1.6;\n  resize: none;\n  background-color: #fafafa;\n}\n\n.input-placeholder {\n  color: #ccc;\n}\n\n.message-count {\n  text-align: right;\n  font-size: 22rpx;\n  color: #999;\n  margin-top: 8rpx;\n}\n\n/* 提示卡片 */\n.tips-card {\n  background-color: #fff9f5;\n  border-left: 4rpx solid #ff7043;\n}\n\n.tips-title {\n  font-size: 26rpx;\n  font-weight: 600;\n  color: #333;\n  margin-bottom: 16rpx;\n}\n\n.tips-item {\n  display: flex;\n  align-items: flex-start;\n  gap: 12rpx;\n  margin-bottom: 12rpx;\n  font-size: 24rpx;\n  line-height: 1.6;\n}\n\n.tips-item:last-child {\n  margin-bottom: 0;\n}\n\n.tips-icon {\n  color: #ff7043;\n  font-size: 16rpx;\n  flex-shrink: 0;\n  margin-top: 4rpx;\n}\n\n.tips-text {\n  color: #666;\n  flex: 1;\n}\n\n/* 按钮容器 */\n.button-container {\n  padding: 40rpx 20rpx 20rpx 20rpx;\n  position: fixed;\n  bottom: 0;\n  left: 0;\n  right: 0;\n  background: linear-gradient(to bottom, transparent, rgba(255, 255, 255, 0.95) 20%, #fff);\n  z-index: 10;\n}\n\n.btn-share {\n  width: 100%;\n  height: 56rpx;\n  background: linear-gradient(135deg, #ff7043 0%, #ff5722 100%);\n  color: #fff;\n  border: none;\n  border-radius: 28rpx;\n  font-size: 32rpx;\n  font-weight: 600;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 12rpx;\n  box-shadow: 0 4rpx 16rpx rgba(255, 87, 34, 0.3);\n}\n\n.btn-share::after {\n  border: none;\n}\n\n.btn-share:active {\n  opacity: 0.9;\n  transform: scale(0.98);\n}\n\n.btn-icon {\n  font-size: 28rpx;\n}\n\n.button-hint {\n  text-align: center;\n  color: #999;\n  font-size: 22rpx;\n  margin-top: 12rpx;\n  line-height: 1.4;\n}\n\n/* 大屏幕适配 */\n@media (min-width: 414px) {\n  .card-item {\n    margin-left: 30rpx;\n    margin-right: 30rpx;\n  }\n\n  .button-container {\n    padding: 40rpx 30rpx 20rpx 30rpx;\n  }\n}