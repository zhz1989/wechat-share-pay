/**pages/paySuccess/index.wxss**/\n\npage {\n  background-color: #f5f5f5;\n}\n\n.container {\n  padding: 0;\n  min-height: 100vh;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  padding-bottom: 40rpx;\n}\n\n/* 成功动画 */\n.success-animation {\n  margin-top: 60rpx;\n  margin-bottom: 40rpx;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.success-checkmark {\n  position: relative;\n  width: 120rpx;\n  height: 120rpx;\n}\n\n.checkmark-circle {\n  position: absolute;\n  width: 100%;\n  height: 100%;\n  border-radius: 50%;\n  background: linear-gradient(135deg, #4caf50 0%, #45a049 100%);\n  animation: scaleIn 0.6s ease-out;\n}\n\n.checkmark-check {\n  position: absolute;\n  width: 100%;\n  height: 100%;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: 60rpx;\n  color: #fff;\n  font-weight: bold;\n  animation: popIn 0.6s ease-out 0.3s both;\n}\n\n.checkmark-check::before {\n  content: '✓';\n}\n\n@keyframes scaleIn {\n  0% {\n    transform: scale(0);\n    opacity: 0;\n  }\n  50% {\n    transform: scale(1.1);\n  }\n  100% {\n    transform: scale(1);\n    opacity: 1;\n  }\n}\n\n@keyframes popIn {\n  0% {\n    transform: scale(0);\n    opacity: 0;\n  }\n  100% {\n    transform: scale(1);\n    opacity: 1;\n  }\n}\n\n/* 成功内容 */\n.success-content {\n  text-align: center;\n  margin-bottom: 40rpx;\n}\n\n.success-title {\n  display: block;\n  font-size: 40rpx;\n  font-weight: 700;\n  color: #333;\n  margin-bottom: 12rpx;\n}\n\n.success-subtitle {\n  display: block;\n  font-size: 28rpx;\n  color: #999;\n  line-height: 1.6;\n}\n\n/* 卡片基础样式 */\n.card-item {\n  width: 100%;\n  background-color: #fff;\n  padding: 24rpx 30rpx;\n  margin: 16rpx 0;\n  box-sizing: border-box;\n}\n\n/* 卡片行 */\n.card-row {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 16rpx 0;\n}\n\n.card-label {\n  font-size: 28rpx;\n  color: #666;\n  flex: 1;\n}\n\n.card-value {\n  font-size: 28rpx;\n  color: #333;\n  font-weight: 600;\n  text-align: right;\n  flex: 1;\n}\n\n.card-value.amount {\n  font-size: 32rpx;\n  color: #ff5722;\n  font-weight: 700;\n}\n\n.card-value.order-id {\n  font-family: 'Courier New', monospace;\n  font-size: 24rpx;\n  color: #999;\n}\n\n/* 分隔线 */\n.divider {\n  height: 1rpx;\n  background-color: #f0f0f0;\n  margin: 0;\n}\n\n/* 提示卡片 */\n.tips-card {\n  background-color: #f0f7ff;\n  border-left: 4rpx solid #2196f3;\n}\n\n.tips-item {\n  display: flex;\n  align-items: flex-start;\n  gap: 12rpx;\n  margin: 16rpx 0;\n  font-size: 26rpx;\n  line-height: 1.6;\n}\n\n.tips-item:first-child {\n  margin-top: 0;\n}\n\n.tips-item:last-child {\n  margin-bottom: 0;\n}\n\n.tips-icon {\n  color: #2196f3;\n  font-size: 20rpx;\n  flex-shrink: 0;\n  margin-top: 4rpx;\n}\n\n.tips-text {\n  color: #666;\n  flex: 1;\n}\n\n/* 按钮容器 */\n.button-group {\n  width: 100%;\n  padding: 20rpx 30rpx;\n  box-sizing: border-box;\n  display: flex;\n  flex-direction: column;\n  gap: 16rpx;\n}\n\n.btn-primary,\n.btn-secondary {\n  width: 100%;\n  height: 56rpx;\n  border: none;\n  border-radius: 28rpx;\n  font-size: 32rpx;\n  font-weight: 600;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.btn-primary {\n  background: linear-gradient(135deg, #4caf50 0%, #45a049 100%);\n  color: #fff;\n  box-shadow: 0 4rpx 16rpx rgba(76, 175, 80, 0.3);\n}\n\n.btn-primary::after {\n  border: none;\n}\n\n.btn-primary:active {\n  opacity: 0.9;\n  transform: scale(0.98);\n}\n\n.btn-secondary {\n  background-color: #f5f5f5;\n  color: #333;\n  border: 1rpx solid #eee;\n}\n\n.btn-secondary::after {\n  border: none;\n}\n\n.btn-secondary:active {\n  opacity: 0.8;\n  transform: scale(0.98);\n}\n\n/* 响应式调整 */\n@media (min-width: 414px) {\n  .container {\n    padding-bottom: 60rpx;\n  }\n\n  .success-title {\n    font-size: 48rpx;\n  }\n}\n