<!--pages/paySuccess/index.wxml-->\n<view class=\"container\">\n  <!-- 成功动画容器 -->\n  <view class=\"success-animation\">\n    <!-- 成功勾选图标 -->\n    <view class=\"success-checkmark\">\n      <view class=\"checkmark-circle\"></view>\n      <view class=\"checkmark-check\"></view>\n    </view>\n  </view>\n\n  <!-- 成功信息 -->\n  <view class=\"success-content\">\n    <text class=\"success-title\">支付成功！</text>\n    <text class=\"success-subtitle\">款项已转给 {{payerName}}</text>\n  </view>\n\n  <!-- 订单信息卡片 -->\n  <view class=\"card-item\">\n    <view class=\"card-row\">\n      <text class=\"card-label\">付款金额</text>\n      <text class=\"card-value amount\">¥{{amount}}</text>\n    </view>\n    <view class=\"divider\"></view>\n    <view class=\"card-row\">\n      <text class=\"card-label\">订单号</text>\n      <text class=\"card-value order-id\">{{orderId}}</text>\n    </view>\n    <view class=\"divider\"></view>\n    <view class=\"card-row\">\n      <text class=\"card-label\">支付时间</text>\n      <text class=\"card-value\">{{paymentTime}}</text>\n    </view>\n  </view>\n\n  <!-- 提示卡片 -->\n  <view class=\"card-item tips-card\">\n    <view class=\"tips-item\">\n      <text class=\"tips-icon\">✓</text>\n      <text class=\"tips-text\">交易已完成，请妥善保管订单信息</text>\n    </view>\n    <view class=\"tips-item\">\n      <text class=\"tips-icon\">✓</text>\n      <text class=\"tips-text\">发票将通过微信消息发送给您</text>\n    </view>\n  </view>\n\n  <!-- 底部按钮 -->\n  <view class=\"button-group\">\n    <button class=\"btn-primary\" bindtap=\"handleBackHome\">\n      <text>返回首页</text>\n    </button>\n    <button class=\"btn-secondary\" bindtap=\"handleViewDetail\">\n      <text>查看详情</text>\n    </button>\n  </view>\n</view>